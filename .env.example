# Copy to ignored .env.local and populate through trusted provider secret stores.
# These are names/placeholders only. Never commit actual credentials.
APP_ORIGIN=https://flight-ai-two.vercel.app
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Alternative to SUPABASE_ANON_KEY when using Supabase publishable keys:
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Base64-encoded cryptographically random 32-byte key; preserve for token decryption.
TOKEN_ENCRYPTION_KEY=
AI_GATEWAY_API_KEY=

# Source OAuth applications, separate from Supabase Google/Apple sign-in apps.
CONNECTOR_GMAIL_CLIENT_ID=
CONNECTOR_GMAIL_CLIENT_SECRET=
CONNECTOR_MICROSOFT_CLIENT_ID=
CONNECTOR_MICROSOFT_CLIENT_SECRET=
CONNECTOR_HUBSPOT_CLIENT_ID=
CONNECTOR_HUBSPOT_CLIENT_SECRET=
CONNECTOR_ZENDESK_CLIENT_ID=
CONNECTOR_ZENDESK_CLIENT_SECRET=
CONNECTOR_INTERCOM_CLIENT_ID=
CONNECTOR_INTERCOM_CLIENT_SECRET=

# Migration/integration tooling only; never expose through browser config.
POSTGRES_URL_NON_POOLING=
POSTGRES_URL=
POSTGRES_CA_PATH=
# Optional local server/test settings:
PORT=8092
PRODUCT_TEST_ORIGIN=http://127.0.0.1:8092
